FROM mcr.microsoft.com/windows/servercore:ltsc2019

WORKDIR C:\app

RUN powershell -Command choco install -y python --version=3.10.0

RUN powershell -Command choco install -y visualstudio2019-workload-vctools

RUN powershell -Command choco install -y freetds

RUN powershell -Command $env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User')

COPY requirements_api.txt .

RUN powershell -Command pip install --upgrade pip

RUN powershell -Command pip install --no-cache-dir -r requirements_api.txt

RUN powershell -Command pip install --no-cache-dir pymssql==2.2.11

COPY api\ .\api\
COPY backend\ .\backend\

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD powershell -Command "try { $response = Invoke-WebRequest -Uri 'http://localhost:8000/api/health' -UseBasicParsing; exit 0 } catch { exit 1 }"

ENTRYPOINT ["powershell", "-Command", "uvicorn api:app --host 0.0.0.0 --port 8000 --workers 1"]
